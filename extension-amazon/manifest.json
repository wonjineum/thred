{
  "manifest_version": 3,
  "name": "Thred",
  "version": "0.1.0",
  "description": "Shows sustainability scores and alternatives beside Amazon carts.",
  "permissions": ["activeTab"],
  "host_permissions": ["https://*.amazon.com/*"],
  "action": {
    "default_title": "Open Thred sidebar",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://*.amazon.com/gp/cart/*", "https://*.amazon.com/cart/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}